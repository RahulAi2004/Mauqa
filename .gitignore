# ---- dependencies & build output ----
node_modules/
dist/
.vite/
*.tsbuildinfo

# ---- secrets ----
# .env holds the real OPENROUTER_API_KEY. Never commit it.
# .env.example is the committed template and is re-included below.
.env
.env.*
!.env.example

# ---- local database (contains real accounts, password hashes, personal items) ----
server/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- logs & temporary files ----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
.cache/
coverage/
tmp/

# ---- editor / agent / OS ----
.claude/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- build artefacts that must not be committed ----
public/*.apk
public/.well-known/assetlinks.json
