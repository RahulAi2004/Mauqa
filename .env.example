# Copy to .env and fill in. Without a key the app still works — extraction runs
# in "basic" mode using the local regex extractor, and every field is flagged
# for review. .env is gitignored; never commit a real key.

# ---- AI extraction (OpenRouter) ----
# Server-side only. This value is never sent to the browser, the bundle or an APK.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides:
# OPENROUTER_MODEL=google/gemini-3.5-flash       # default
# OPENROUTER_TIMEOUT_MS=20000                    # per request; 1 retry on transient failure
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Android app ----
# URL of the hosted .apk (PWABuilder generates one from the deployed site).
# Read by the browser at BUILD time, so re-run `npm run build` after setting it.
# Leave unset and every download button stays hidden — no dead links.
# Only VITE_-prefixed values reach the browser; the key above never does.
# VITE_APK_URL=https://your-domain/mauqa.apk

# ---- ports ----
# API_PORT=4200
# PORT=5183
